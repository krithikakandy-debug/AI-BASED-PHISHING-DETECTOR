{
  "manifest_version": 3,
  "name": "PhishGuard Pro",
  "version": "1.0.0",
  "description": "Real-time phishing detection with AI-powered threat explanations.",
  "permissions": ["tabs", "sidePanel", "activeTab", "storage", "downloads", "clipboardWrite"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Open PhishGuard Pro"
  }
}
